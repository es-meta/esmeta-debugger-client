{
  "name": "esmeta-debugger-client",
  "version": "0.2.1",
  "type": "module",
  "private": true,
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@xyflow/react": "^12.11.1",
    "awesome-debounce-promise": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-graphviz": "^5.6.0",
    "ecmarkdown": "^8.1.0",
    "fzf": "^0.5.2",
    "jotai": "^2.20.1",
    "lucide-react": "^0.577.0",
    "motion": "^11.18.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intersection-observer": "^9.16.0",
    "react-resizable-panels": "^2.1.9",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-styled-components": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.1",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "start": "vite build --base=/ && vite preview",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:root": "ESMETA_CLIENT_WORKER_AS_DEFAULT=true node scripts/build-with-base.mjs /",
    "build:base": "ESMETA_CLIENT_WORKER_AS_DEFAULT=true node scripts/build-with-base.mjs",
    "lint": "eslint .",
    "format": "npx prettier --write 'src/**/*.{js,ts,tsx,mjs,cjs,json}' | grep -v '(unchanged)'",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/d3-graphviz": "^2.6.10",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefix": "^1.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
